# --- SAP Analytics Cloud tenant ---
# Tenant URL (no trailing slash), e.g. https://mycompany.eu10.hcs.cloud.sap
SAC_TENANT_URL=

# Authorization server URL, e.g. https://mycompany.authentication.eu10.hana.ondemand.com
SAC_AUTH_URL=

# OAuth 2.0 client credentials (create in SAC: System > Administration > App Integration)
SAC_CLIENT_ID=
SAC_CLIENT_SECRET=

# Optional OAuth scope (leave blank for default)
SAC_OAUTH_SCOPE=

# --- HTTP behavior ---
SAC_REQUEST_TIMEOUT=60
SAC_MAX_RETRIES=4
SAC_PAGE_SIZE=1000
SAC_MAX_RPS=10

# --- MCP transport ---
# stdio | http
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765
# Required when MCP_TRANSPORT=http. Treat this as a shared secret — clients must
# send `Authorization: Bearer <token>` and anyone who learns the value can call
# every tool on the server. Generate with:  openssl rand -hex 32
# Never reuse across environments. Rotate on a schedule and immediately after
# any suspected exposure (chat paste, screenshot, accidental commit, etc.).
MCP_HTTP_BEARER=
# Comma-separated CORS origins, e.g. https://app.example.com,https://other.example.com
MCP_HTTP_CORS_ORIGINS=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
